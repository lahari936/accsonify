# Backend runtime settings
# Comma-separated allowed frontend origins for CORS
FRONTEND_ORIGIN=https://<your-netlify-domain>

# Temporary: allow startup while model artifacts are not present.
ALLOW_MOCK_MODE=true

# For real inference, place these files in accsonify-backend/ and then switch:
# - svm_model.pkl
# - label_encoder.pkl
# ALLOW_MOCK_MODE=false
